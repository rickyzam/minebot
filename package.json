{
  "name": "minebot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-connect.ts",
    "demo": "tsx packages/executor/src/cli.ts",
    "demo:phase2": "tsx packages/executor/src/phase2-demo.ts",
    "demo:phase3": "tsx packages/bot/src/phase3-demo.ts",
    "demo:phase4": "tsx packages/bot/src/phase4-demo.ts",
    "bots": "tsx scripts/spawn-bots.ts",
    "arena:map": "tsx scripts/arena-map.ts",
    "bench:world": "tsx scripts/bench-world.ts",
    "bench:explore": "tsx scripts/bench-explore.ts",
    "bench:perception": "tsx scripts/bench-perception.ts",
    "agent:probe": "tsx packages/agent/src/probe.ts",
    "agent:demo": "tsx packages/agent/src/demo.ts",
    "explore:path": "tsx scripts/explore-path.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
